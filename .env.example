# Standalone Oni247 configuration. Copy to .env and fill every required value.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Reverse-proxy trust: false by default; set to a hop count (e.g. 1) only behind a known proxy.
TRUST_PROXY=false
COOKIE_SECURE=false
APP_BASE_URL=

# PostgreSQL — use the standalone Oni247 database, not Floot's database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_POOL_MAX=10

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

# S3-compatible object storage (Cloudflare R2, AWS S3, or compatible provider).
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=oni247-assets
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
PUBLIC_ASSETS_BASE_URL=https://cdn.example.com

# Encrypts stored payment/email provider credentials; use a separate random secret.
EMAIL_SETTINGS_KEY=replace-with-a-different-random-secret

# Optional default SMTP sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
EMAIL_INBOX_DOMAIN=
EMAIL_INBOUND_SECRET=

# Configure payment gateway secrets through the Oni247 admin settings, or the
# environment variables supported by the payment integration modules.
