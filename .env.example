# Oni247 application configuration. Copy to .env and fill every required value.
NODE_ENV=development
# Next.js owns the public PORT supplied by the hosting platform.
# Fastify binds privately on loopback; use HOST=0.0.0.0 only if running it as a separate private service.
HOST=127.0.0.1
API_PORT=3001
# Fastify trusts exactly one hop: the local Next.js API proxy.
TRUST_PROXY=1
COOKIE_SECURE=false
APP_BASE_URL=
# Optional internal Fastify origin used by the Next.js proxy; defaults to http://127.0.0.1:3001.
ONI247_API_INTERNAL_URL=http://127.0.0.1:3001
# Canonical platform hostname. Business storefronts use https://oni247.org/{slug}.
PLATFORM_ROOT_DOMAIN=https://oni247.org
# Render supplies this hostname automatically; set it explicitly for local staging if needed.
RENDER_EXTERNAL_HOSTNAME=oni247-staging.onrender.com

# PostgreSQL — use the dedicated Oni247 database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_POOL_MAX=10

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

# S3-compatible object storage. Configure these values for your chosen provider.
# Keep credentials scoped to the Oni247 media bucket.
S3_ENDPOINT=https://your-s3-compatible-endpoint.example
S3_REGION=your-region
S3_BUCKET=oni247-media
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
# Leave empty until a controlled public media delivery URL is configured.
# Do not enable public bucket access just to make this value work.
PUBLIC_ASSETS_BASE_URL=

# Encrypts stored payment/email provider credentials; use a separate random secret.
EMAIL_SETTINGS_KEY=replace-with-a-different-random-secret

# Optional default SMTP sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
EMAIL_INBOX_DOMAIN=
EMAIL_INBOUND_SECRET=

# Configure payment gateway secrets through the Oni247 admin settings, or the
# environment variables supported by the payment integration modules.
