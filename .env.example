# Standalone Oni247 configuration. Copy to .env and fill every required value.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Reverse-proxy trust: false by default; set to a hop count (e.g. 1) only behind a known proxy.
TRUST_PROXY=false
COOKIE_SECURE=false
APP_BASE_URL=
# Apex/root hostname for business subdomains (e.g. shop.oni247.org).
# Configure wildcard DNS (*.oni247.org) and a wildcard certificate at the hosting layer.
PLATFORM_ROOT_DOMAIN=oni247.org
# Set true only after *.oni247.org is added and verified on Render and wildcard DNS/TLS works.
PLATFORM_WILDCARD_READY=false
# Render-managed customer domain provisioning. Keep the API key server-side only.
# Create a Render API key with permission to manage custom domains for this workspace.
RENDER_API_KEY=
# Render service ID for the Oni247 web service (not the onrender.com hostname).
RENDER_SERVICE_ID=srv-dc3ej8c0916s738jhr7g
# Exact service hostname, e.g. oni247-staging.onrender.com; used for customer www CNAME instructions.
RENDER_CUSTOM_DOMAIN_TARGET=oni247-staging.onrender.com

# PostgreSQL — use the dedicated Oni247 database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_POOL_MAX=10

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

# Cloudflare R2 S3-compatible object storage.
# The token must have Object Read & Write permission scoped only to oni247-media.
S3_ENDPOINT=https://e4cb886861ca642d44b4b810ff7bf48f.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=oni247-media
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# Leave empty until a controlled public media delivery URL is configured.
# Do not enable public bucket access just to make this value work.
PUBLIC_ASSETS_BASE_URL=

# Encrypts stored payment/email provider credentials; use a separate random secret.
EMAIL_SETTINGS_KEY=replace-with-a-different-random-secret

# Optional default SMTP sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
EMAIL_INBOX_DOMAIN=
EMAIL_INBOUND_SECRET=

# Configure payment gateway secrets through the Oni247 admin settings, or the
# environment variables supported by the payment integration modules.
