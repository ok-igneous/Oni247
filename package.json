    "react-big-calendar": "^1.19.4",
    "react-day-picker": "^9.5.1",
    "react-dom": "^19.2.1",
    "react-helmet": "^6.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "6.30.6",
    "recharts": "^2.15.1",
    "sanitize-html": "^2.17.0",
